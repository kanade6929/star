# Cloudflare Workers / Pages 的缓存设置（GitHub Pages 会忽略这个文件）。
# 指纹资源内容改变就换 URL，可安全缓存一年；入口页面继续每次检查更新。
/assets/*
  Cache-Control: public, max-age=31536000, immutable
# 原路径保留给旧页面和兼容入口。
/audio/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=2592000
/fonts/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=2592000
/img/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=2592000
